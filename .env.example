# ---------------------------------------------------------------------------
# Lead delivery
# ---------------------------------------------------------------------------
# Leads are always appended to var/leads.jsonl as a backup; email delivery
# activates once both variables below are set.

# Where lead notifications are sent.
LEAD_TO_EMAIL=you@example.com

# Free API key from https://resend.com (100 emails/day on the free tier).
# Without a verified domain, Resend only delivers to your own account email,
# which is exactly what a lead notification needs.
RESEND_API_KEY=

# Optional: custom sender once you verify a domain in Resend.
# LEAD_FROM_EMAIL="Audit Leads <leads@yourdomain.com>"


# ---------------------------------------------------------------------------
# Measurement — see docs/measurement-plan.md
# ---------------------------------------------------------------------------
# All NEXT_PUBLIC_*, because they are inlined into the client bundle and are
# public identifiers by design. Nothing secret belongs below this line.
#
# Leave these blank and the site sends nothing at all. That is the intended
# state for local development and for preview deployments — set them only in
# the production environment, or your own clicking around becomes your data.

# GA4 measurement ID: Admin → Data streams → your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads conversion ID: Goals → Conversions → Google tag. Format AW-XXXXXXXXXX.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion labels — the string after the slash in a conversion action's
# `send_to` value. One per conversion action created in Google Ads.
NEXT_PUBLIC_ADS_LABEL_AUDIT=
NEXT_PUBLIC_ADS_LABEL_ENQUIRY=

# Set to 1 to log every analytics event to the console without sending
# anything. Useful for checking the event taxonomy while building.
# NEXT_PUBLIC_ANALYTICS_DEBUG=1
